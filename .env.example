# ============================================================
# Cartrends AutoFlow configuration
# Copy this file to .env and fill in as your WhatsApp setup completes.
#
# RULE: a bot with an EMPTY number runs in SIMULATION mode (test it
# from the web console). The moment you put its number here and
# restart, it goes LIVE — a QR code appears in the console, scan it
# with that number's phone (WhatsApp > Linked devices).
# ============================================================

# ---- Bot numbers (digits only, country code first, e.g. 919876540414) ----
#
# YOU ONLY NEED 2 NUMBERS. Roles can SHARE a number: write the same number
# in several slots and those roles ride on one WhatsApp line (one QR scan).
# Recommended 2-number setup:
#   CUSTOMER_BOT_NUMBER  = number A  (sales — its own line, heavy traffic)
#   PURCHASE_BOT_NUMBER  = number B
#   WAREHOUSE_BOT_NUMBER = number B  (same as purchase)
#   FINANCE_BOT_NUMBER   = number B  (same as purchase)
#   HELPDESK_BOT_NUMBER  = number B  (same as purchase)
# On a shared line, messages route by priority: vendor messages -> purchase,
# warehouse commands (DO/DONE/REGISTER PICKER) -> warehouse, STATEMENT ->
# finance, anything else from employees -> helpdesk ticket.
# You can move a role to its own number later by just changing its slot.
PURCHASE_BOT_NUMBER=
CUSTOMER_BOT_NUMBER=
WAREHOUSE_BOT_NUMBER=
FINANCE_BOT_NUMBER=
HELPDESK_BOT_NUMBER=

# ---- Customer bot ----
# Comma-separated WhatsApp group names the customer bot should listen to.
# Leave empty to listen to ALL groups it is a member of (plus direct chats).
# DM whitelist: sirf in numbers ke direct messages ka jawab milega
# (comma separated, 91 ke saath). Khali = bot kisi DM par react NAHI karega.
CUSTOMER_DMS=

CUSTOMER_GROUPS=

# ---- Warehouse ----
# Numbers that receive dispatch / inbound-transit alerts (comma separated)
WAREHOUSE_TEAM_NUMBERS=
# Internal warehouse name used in replies
INTERNAL_WAREHOUSE_NAME=Bijwasan

# ---- Schedules (24h HH:MM, comma separated; timezone below) ----
TZ=Asia/Kolkata
STOCK_BROADCAST_TIMES=09:30,16:00
IVR_FOLLOWUP_TIMES=11:30,17:30
# Cron for hourly vendor invoice chase (default: every hour on the hour)
INVOICE_CHASE_CRON=0 * * * *

# ---- Admin over WhatsApp (no UI needed) ----
# These numbers can message ANY bot line with commands: REPORT, STOCK,
# ORDERS, POS, OFFER <text>, HIGHLIGHTS, CN <phone> <amount> <reason>,
# VENDOR ADD name, phone · CUSTOMER ADD name, phone · STOCKREQ · CHASE · HELP
ADMIN_NUMBERS=
# Daily ops report pushed to admins at this time
DAILY_REPORT_TIME=20:00

# ---- Dealer Portal: the ONLY source of stock and orders ----
# Vendor stock reaches the portal from ProcureHub, NOT from this process.
# This bot asks the portal what is available (analyze) and punches the
# confirmed sales order there (confirm). Leave BASE_URL empty to run against
# the built-in MOCK portal (seeded via the console) so the sales flow still
# works offline.
# Host confirmed 31 Aug 2026: vagmine.* is the API, cartrend.* is the storefront
# UI (NOT the API). Old host vagmine.mycentralpark.in is superseded.
DEALER_PORTAL_BASE_URL=https://vagmine.vagminetech.com/api/v1

# Auth: a permanent / refresh token is preferred. With DEALER_PORTAL_TOKEN set
# there is no interactive login at all (no 8h expiry, no device_id clash).
DEALER_PORTAL_TOKEN=
# Fallback: interactive login with username + password.
DEALER_PORTAL_USERNAME=
DEALER_PORTAL_PASSWORD=
DEALER_PORTAL_DEVICE_ID=cartrends-autoflow-sales

# Endpoint paths. /auth/login is VERIFIED. analyze and confirm are still to be
# confirmed with Aneeq sir -- when he shares them, change them HERE, not in
# the code.
DEALER_PORTAL_LOGIN_PATH=/auth/login
DEALER_PORTAL_ANALYZE_PATH=/orders/analyze
DEALER_PORTAL_CONFIRM_PATH=/orders/confirm
DEALER_PORTAL_TIMEOUT_MS=20000

# ---- Scope ----
# Current phase is the SALES BOT ONLY. purchase / warehouse / finance /
# helpdesk are parked -- code intact, but they do not boot.
ENABLE_EXTRA_BOTS=false

# ---- Photo order OCR ----
# No config needed. Chain: Python libraries (pip install pytesseract or
# easyocr) -> Windows built-in OCR (works out of the box on this machine)
# -> Claude vision (only if ANTHROPIC_API_KEY is set).

# ---- IVR / voice calls: mock | twilio ----
IVR_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- AI message understanding (optional but recommended) ----
# With a key set, customer/vendor messages are parsed by Claude.
# Without it, a deterministic line parser is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Web console ----
CONSOLE_PORT=3010

# ---- Human-confirm escalation ----
# Part/naam par confusion ho to bot pehle is number ko DM karega; itne minute
# mein jawab nahi aaya to customer ko polite fallback reply jaayega.
# NOTE: yeh number kisi BOT LINE se alag hona chahiye (self-DM ka reply nahi milta).
ESCALATION_NUMBER=9217030421
ESCALATION_TIMEOUT_MIN=5
